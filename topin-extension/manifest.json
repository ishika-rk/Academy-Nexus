{
  "manifest_version": 3,
  "name": "Academy Nexus – Topin Automation",
  "version": "1.0.0",
  "description": "Clones and publishes Topin assessment configs from the Academy Nexus Assessment Generation page. Only talks to config.topin.tech and the Academy Nexus app.",
  "key": "",
  "permissions": ["tabs", "clipboardRead"],
  "host_permissions": ["https://config.topin.tech/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://config.topin.tech/*"],
      "js": ["content-topin.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://academy-nexus-gray.vercel.app/*",
      "http://localhost:5173/*",
      "http://localhost:5174/*"
    ]
  }
}
